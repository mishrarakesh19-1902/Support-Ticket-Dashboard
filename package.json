{
  "name": "support-ticket-dashboard",
  "version": "1.0.0",
  "private": true,
  "description": "Support Ticket Dashboard monorepo",
  "scripts": {
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev": "npm run dev:backend",
    "build": "npm --prefix backend run build && npm --prefix frontend run build",
    "test:backend": "npm --prefix backend run test",
    "test:frontend": "npm --prefix frontend run test",
    "test": "npm run test:backend && npm run test:frontend",
    "seed": "npm --prefix backend run seed"
  }
}
